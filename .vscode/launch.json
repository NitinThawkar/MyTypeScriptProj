{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug TypeScript (ts-node)",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "ts-node",
                "${file}"
            ],
            "outFiles": [
                "${workspaceFolder}/**/*.ts"
            ]
        }
    ]
}